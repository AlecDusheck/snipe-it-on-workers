{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "snipe-it-control-panel",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"observability": {
		"enabled": true,
	},
	"env": {
		"development": {
			"services": [
				{
					"binding": "BACKPLANE",
					"service": "snipe-it-backplane-development",
					"entrypoint": "BackplaneControl",
				},
			],
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare",
			},
		},
		"production": {
			"services": [
				{
					"binding": "BACKPLANE",
					"service": "snipe-it-backplane-production",
					"entrypoint": "BackplaneControl",
				},
			],
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare",
			},
		},
	},
}
